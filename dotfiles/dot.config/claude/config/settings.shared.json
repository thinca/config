{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/bin/settings-sync\" apply >/dev/null",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh\"",
    "refreshInterval": 2
  },
  "language": "japanese",
  "enabledPlugins": {
    "git-base-branch@thinca-config": true,
    "deny-pkill@thinca-config": true,
    "session-status@thinca-config": true
  }
}
